# Helius Wallet API key (keep private; never commit real keys)
HELIUS_API_KEY=

# x402 recipients — set your own receiving addresses
BASE_PAY_TO=
SOLANA_PAY_TO=

# Optional: PayAI facilitator (default shown)
X402_FACILITATOR_URL=https://facilitator.payai.network
# Public base URL used in payment resource metadata (set after deployment)
BASE_URL=https://YOUR-DEPLOYMENT.vercel.app

# Optional per-request price in USD; default $0.01
X402_PRICE=$0.01
